{
	"name": "drago-ex/keycloak",
	"description": "Simple Keycloak adapter for easy integration.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.2",
		"nette/http": "^3.1",
		"nette/di": "^3.0",
		"nette/schema": "^1.2",
		"nette/security": "^3.2",
		"stevenmaguire/oauth2-keycloak": "^6.1"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C"
	}
}
